DEBUG=False

# Database settings
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Caches setting
CACHE_DEFAULT_LOCATION=redis://127.0.0.1:6379/1
CACHE_HR_LOCATION=redis://127.0.0.1:6379/2
CACHE_CUSTOMER_LOCATION=redis://127.0.0.1:6379/3
CACHE_CONTACT_LOCATION=redis://127.0.0.1:6379/4
CACHE_AUTODIALER_LOCATION=redis://127.0.0.1:6379/5

# Celery settings
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_CONFIG_HOST=redis://127.0.0.1:6379/2
CELERY_DEFAULT_QUEUE=
USE_X_FORWARDED_HOST=False
RESTRICT_REPORT=False
PTP_FAMILY=[]
FC_LOGGING_PORT=9000

# Security settings
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
COOKIE_SECURE_FLAG=False

# Email settings
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_PORT=2525
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Static and Media URLs
STATIC_URL=/static/
MEDIA_URL=/media/

# App settings
APP_NAME_PREFIX=

# Elastic APM settings (optional)
ELASTIC_APM_SERVICE_NAME=
ELASTIC_APM_ENVIRONMENT=
